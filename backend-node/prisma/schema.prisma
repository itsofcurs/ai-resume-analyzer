generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  jobs      JobDescription[]
  users         User[]
  auditLogs     AuditLog[]
  aiCosts       AICost[]
  subscription  Subscription?
  usageQuota    UsageQuota?
  invoices         Invoice[]
  aiGovernanceLogs AIGovernanceLog[]
  supportTickets   SupportTicket[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  name           String
  role           String        @default("RECRUITER")
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accountState   String        @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, ACTIVE, SUSPENDED, LOCKED, DELETED
  deletedAt      DateTime?
  googleId       String?       @unique
  provider       String        @default("LOCAL")
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  mfaEnabled     Boolean       @default(false)
  mfaSecret      String?
  lastLogin      DateTime?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  passwordHistory    PasswordHistory[]
  consents           UserConsent[]
  mfaRecoveryCodes   MFARecoveryCode[]
  exportRequests     ExportRequest[]
}

model JobDescription {
  id             String       @id @default(uuid())
  title          String
  description    String
  requiredSkills String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  action         String
  resource       String
  ipAddress      String?
  beforeState    Json?
  afterState     Json?
  severity       String       @default("INFO")
  riskScore      String       @default("LOW") // Legacy string score
  numericRiskScore Int        @default(0) // Numeric score 0-100
  timestamp      DateTime     @default(now())
  
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, timestamp])
  @@index([action, resource])
}

model AICost {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  workflowName   String
  department     String?
  tokensUsed     Int          @default(0)
  promptCost     Float        @default(0.0)
  completionCost Float        @default(0.0)
  totalCost      Float        @default(0.0)
  createdAt      DateTime     @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, department, workflowName])
}

model Subscription {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  planTier             String       @default("STARTER")
  status               String       @default("inactive")
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id])
}

model UsageQuota {
  id             String       @id @default(uuid())
  organizationId String       @unique
  seatsUsed      Int          @default(1)
  seatsLimit     Int          @default(5)
  apiUsage       Int          @default(0)
  apiLimit       Int          @default(1000)
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Invoice {
  id               String       @id @default(uuid())
  organizationId   String
  stripeInvoiceId  String       @unique
  amount           Float
  status           String
  invoiceDate      DateTime
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id])
}

model AIGovernanceLog {
  id                String   @id @default(cuid())

  organizationId    String
  candidateId       String?
  userId            String?

  recommendation    String
  confidence        Float

  reasoning         Json
  contributingFactors Json
  negativeFactors   Json
  auditTrail        Json

  createdAt         DateTime @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([candidateId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model SupportTicket {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  subject        String
  description    String
  status         String       @default("OPEN")
  priority       String       @default("MEDIUM")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  device      String?
  browser     String?
  os          String?
  ipAddress   String?
  location    String?
  createdAt   DateTime @default(now())
  lastSeen    DateTime @default(now())
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailOTP {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  type      String   // "REGISTER", "RESET"
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, type])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  familyId  String
  parentId  String?
  userId    String
  device    String?
  ip        String?
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id          String    @id @default(uuid())
  email       String
  ip          String?
  attempts    Int       @default(1)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([email, ip])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // e.g. "google"
  providerAccountId String   @unique
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  password  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserConsent {
  id               String   @id @default(uuid())
  userId           String
  termsAccepted    Boolean  @default(false)
  privacyAccepted  Boolean  @default(false)
  cookiesAccepted  Boolean  @default(false)
  ipAddress        String?
  timestamp        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailDeliveryLog {
  id          String   @id @default(uuid())
  email       String
  jobId       String?
  messageId   String?  // Resend API Message ID
  status      String   @default("QUEUED") // QUEUED, PROCESSING, DELIVERED, BOUNCED, FAILED
  error       String?
  type        String   // OTP, RESET, INVITATION, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([messageId])
}

model MFARecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExportRequest {
  id            String   @id @default(uuid())
  userId        String
  storagePath   String?
  filename      String?
  status        String   @default("PENDING") // PENDING, PROCESSING, READY, FAILED, EXPIRED, DELETED
  downloadCount Int      @default(0)
  expiresAt     DateTime?
  downloadedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
