# ===========================================
# AI-Resume Analyzer — Git Ignore Rules
# ===========================================

# ── Environment / Secrets ──
.env
.env.local
.env.*.local

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
*.egg
.pytest_cache/

# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Data / ML artifacts ──
chroma_db/
chroma_data/
*.sqlite
*.db

# ── Uploads ──
static/uploads/
uploads/

# ── Build outputs ──
frontend/dist/
frontend/.next/
backend-node/dist/
*.js.map
