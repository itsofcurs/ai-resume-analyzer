ENVIRONMENT=development
APP_NAME=AI Recruitment Intelligence

# Gemini / LLM
LLM_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_S=30
GEMINI_MAX_RETRIES=3

# Storage
MONGODB_URI=mongodb://localhost:27017/talentdb
CHROMA_DB_PATH=./chroma_data

# Cache
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL_S=
CACHE_NAMESPACE=ai-service
REDIS_URL=
REDIS_SOCKET_TIMEOUT_S=2
REDIS_CONNECT_TIMEOUT_S=2

# Concurrency / timeouts
MAX_BATCH_CONCURRENCY=5
MAX_INFLIGHT_JOB_MATCH=10
MAX_INFLIGHT_BATCH=3
MAX_INFLIGHT_PROCESS=10
MAX_INFLIGHT_SEARCH=20
BATCH_PARSE_TIMEOUT_S=30
BATCH_SCORE_TIMEOUT_S=45
REQ_TIMEOUT_JOB_MATCH_S=60
REQ_TIMEOUT_BATCH_S=120
REQ_TIMEOUT_PROCESS_S=60
REQ_TIMEOUT_SEARCH_S=30

# Rate limits (per minute)
RATE_LIMIT_JOB_MATCH_PER_MIN=60
RATE_LIMIT_BATCH_PER_MIN=20
RATE_LIMIT_PROCESS_PER_MIN=60
RATE_LIMIT_SEARCH_PER_MIN=120

# Payload guards
MAX_REQUEST_SIZE_BYTES=2000000
MAX_BATCH_RESUMES=200
INVALID_PAYLOAD_BLOCK_THRESHOLD=5
INVALID_PAYLOAD_BLOCK_SECONDS=60

# Shortlist thresholds
SHORTLIST_STRONG_MATCH=85
SHORTLIST_GOOD_MATCH=70
SHORTLIST_BORDERLINE=55

# Health checks
HEALTHCHECK_TIMEOUT_S=3

# Observability
PROMETHEUS_METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-service
OTEL_EXPORTER_OTLP_ENDPOINT=

# Security
RECRUITER_API_KEYS=
